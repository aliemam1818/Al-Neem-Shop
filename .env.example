# ---- Supabase ----
# Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key is SECRET — server-side only, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Resend (transactional email) ----
# https://resend.com/api-keys — free tier covers order-notification volume for most stores
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must be a domain you've verified in Resend, e.g. orders@yourdomain.com
EMAIL_FROM=ALNEEM Store <orders@yourdomain.com>

# Fallback admin notification address (also editable live from Admin > Settings)
ADMIN_NOTIFICATION_EMAIL=alneemcare@gmail.com

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
